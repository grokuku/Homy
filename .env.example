# Homy — environment variables
# All variables are OPTIONAL: sensible defaults are applied when unset.
# Copy to `.env` (which is gitignored) and adjust as needed.

# HTTP port
PORT=3000

# JWT signing secret.
# Leave EMPTY / unset to let the app auto-generate a 48-byte random secret
# and persist it to data/config.json on first run (recommended).
# Set it explicitly only if you want to manage the secret out-of-band
# (e.g. Docker secret / orchestrator-injected value).
JWT_SECRET=

# JWT expiration (e.g. 1h, 12h, 7d)
JWT_EXPIRES_IN=7d

# bcrypt cost factor
BCRYPT_ROUNDS=12

# Trust the X-Forwarded-For header for rate-limit IP resolution.
# ONLY set to true when running behind a trusted reverse proxy (nginx/traefik/...).
# When false (default), the limit uses the TCP peer address and cannot be
# bypassed by spoofing the header.
TRUST_PROXY=false

# Storage directory. Leave unset to use the default (<project>/server/data).
# Only set a RELATIVE path with care: it is resolved against the working directory.
#DATA_DIR=

# Icon library (lot 7). Base URL of the icon SEARCH/INSTALL service the server
# is allowed to call (allowlist — no client-supplied URL is ever fetched).
# Default is the public, free, no-key Iconify API. Point it at a mirror (or a
# local stub) to self-host the data.
ICONS_API_BASE=https://api.iconify.design

# Outbound timeout (ms) for icon service requests.
ICONS_TIMEOUT_MS=8000

# Outbound timeout (ms) for report service calls (lot 8: Jellyfin & co).
REPORTS_TIMEOUT_MS=8000

# ---- Docky integration (lot 5) --------------------------------------------
# Base URL of the Docky integration API. Provide either the full versioned base
# (https://docky.example.tld/api/integration/v1) or just the host
# (https://docky.example.tld) — the /api/integration/v1 suffix is appended
# automatically. Leave UNSET to configure it from the UI (stored server-side in
# DATA_DIR/docky.json). When set here it OVERRIDES the stored value.
# The base URL is a single allow-listed value: Homy never fetches an arbitrary
# host.
DOCKY_URL=

# DEDICATED integration key (Bearer), shown/copied/regenerated in Docky under
# Settings → API d'intégration. It is stored server-side ONLY and is NEVER
# returned by an API response nor written to a log. When set here it OVERRIDES
# the stored value.
DOCKY_KEY=

# Outbound timeouts (ms): state/health/agents, stats, actions. Bounded
# server-side (contract: <=15 s stats, <=20 s actions).
DOCKY_TIMEOUT_MS=8000
DOCKY_STATS_TIMEOUT_MS=15000
DOCKY_ACTION_TIMEOUT_MS=20000

# In-memory cache TTL (ms) for health/stats/agents, so a ~30 s dashboard cycle
# does not hammer Docky.
DOCKY_CACHE_MS=30000

# ---- Custom health checks (element.healthUrl) -----------------------------
# Bounded, credential-free HTTP(S) probing for elements whose health pill comes
# from a custom URL (e.g. https://jf.holaf.fr/health). Only http(s) is accepted;
# `file:`/`ftp:`/… and URLs with embedded credentials are rejected with 400
# BEFORE any fetch. At most 20 URLs may be probed per request; results are
# cached in memory (per URL) so a ~30 s dashboard cycle probes each host once.
HEALTH_TIMEOUT_MS=5000
HEALTH_CACHE_MS=30000
