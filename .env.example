# Homy — environment variables
# All variables are OPTIONAL: sensible defaults are applied when unset.
# Copy to `.env` (which is gitignored) and adjust as needed.

# HTTP port
PORT=3000

# JWT signing secret.
# Leave EMPTY / unset to let the app auto-generate a 48-byte random secret
# and persist it to data/config.json on first run (recommended).
# Set it explicitly only if you want to manage the secret out-of-band
# (e.g. Docker secret / orchestrator-injected value).
JWT_SECRET=

# JWT expiration (e.g. 1h, 12h, 7d)
JWT_EXPIRES_IN=7d

# bcrypt cost factor
BCRYPT_ROUNDS=12

# Trust the X-Forwarded-For header for rate-limit IP resolution.
# ONLY set to true when running behind a trusted reverse proxy (nginx/traefik/...).
# When false (default), the limit uses the TCP peer address and cannot be
# bypassed by spoofing the header.
TRUST_PROXY=false

# Storage directory. Leave unset to use the default (<project>/server/data).
# Only set a RELATIVE path with care: it is resolved against the working directory.
#DATA_DIR=

# Icon library (lot 7). Base URL of the icon SEARCH/INSTALL service the server
# is allowed to call (allowlist — no client-supplied URL is ever fetched).
# Default is the public, free, no-key Iconify API. Point it at a mirror (or a
# local stub) to self-host the data.
ICONS_API_BASE=https://api.iconify.design

# Outbound timeout (ms) for icon service requests.
ICONS_TIMEOUT_MS=8000

# Outbound timeout (ms) for report service calls (lot 8: Jellyfin & co).
REPORTS_TIMEOUT_MS=8000
